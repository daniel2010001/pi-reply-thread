{
  "name": "pi-reply-thread",
  "version": "0.2.0",
  "description": "Index the replies one prompt produces in a Pi or Gentle Shell session: ordered and unique IDs, what triggered each reply, and the replies still waiting on you.",
  "type": "module",
  "license": "MIT",
  "author": "Daniel Li",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daniel2010001/pi-reply-thread.git"
  },
  "homepage": "https://github.com/daniel2010001/pi-reply-thread#readme",
  "bugs": {
    "url": "https://github.com/daniel2010001/pi-reply-thread/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "gentle-shell",
    "tui"
  ],
  "pi": {
    "extensions": [
      "./extensions/reply-thread.ts"
    ]
  },
  "files": [
    "extensions",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "demo": "node scripts/demo-session.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.2.0 <2",
    "@earendil-works/pi-tui": ">=1.2.0 <2"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "^26.6.5",
    "typescript": "^6.0.2",
    "vitest": "^5.0.5"
  }
}
